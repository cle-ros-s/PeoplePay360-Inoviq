{
  "name": "peoplepay360-root",
  "version": "1.0.0",
  "description": "Root workspace runner for PeoplePay360 Frontend & Backend",
  "scripts": {
    "dev:backend": "npm --prefix odoo-backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npm --prefix odoo-backend run dev",
    "start": "npm --prefix odoo-backend start",
    "start:backend": "npm --prefix odoo-backend start",
    "start:frontend": "npm --prefix frontend run preview",
    "build:frontend": "npm --prefix frontend run build",
    "prisma:generate": "npm --prefix odoo-backend run prisma:generate",
    "prisma:push": "npm --prefix odoo-backend run prisma:push",
    "prisma:seed": "npm --prefix odoo-backend run prisma:seed",
    "test": "npm --prefix odoo-backend test"
  }
}
